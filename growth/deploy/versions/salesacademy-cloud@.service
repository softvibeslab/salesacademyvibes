[Unit]
Description=Sales Academy Cloud %i editorial experience
After=network.target

[Service]
Type=simple
User=sa-cloud-%i
Group=sa-cloud-%i
WorkingDirectory=/srv/salesacademy-cloud/current/%i
EnvironmentFile=/etc/salesacademy-cloud/%i.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/salesacademy-cloud/venv/bin/gunicorn --bind 127.0.0.1:${SA_PORT} --workers 1 --threads 4 --timeout 60 --max-requests 2000 --max-requests-jitter 200 --forwarded-allow-ips 127.0.0.1 --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/salesacademy-cloud/%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
